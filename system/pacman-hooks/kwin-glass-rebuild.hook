# kwin-effects-glass-git and kwin-effect-rounded-corners-git are built against a specific KWin version and stops loading
# after KWin is upgraded. This hook only warns: a hook cannot run paru (pacman is locked).
[Trigger]
Operation = Upgrade
Type = Package
Target = kwin

[Action]
Description = KWin was upgraded: the liquid glass and rounded corners effects need a rebuild
When = PostTransaction
Exec = /usr/bin/echo ">>> KWin upgraded: run 'fixglass' in fish, then log out and back in."
